flowchart TD
    A["Mulai"] --> B["Input Dokumen"]
    B --> C["Input Kunci Privat RSA & ECC"]
    C --> D["Baca File Dokumen"]
    D --> E["Hitung SHA-256 Hash Dokumen"]
    E --> F["Tanda Tangani Hash dengan Kunci Privat RSA"]
    F --> G["Generate Kunci AES-256"]
    G --> H["Enkripsi Dokumen dengan AES-256"]
    H --> I["Dapatkan Kunci Publik RSA & ECC"]
    I --> J["Enkripsi Kunci AES dengan Kunci Publik RSA"]
    J --> K["Tanda Tangani Data Terenkripsi dengan Kunci Privat ECC"]
    K --> L["Buat Metadata JSON"]
    L --> M["Simpan Dokumen Terenkripsi"]
    M --> N["Simpan File Metadata"]
    N --> O["Selesai"]