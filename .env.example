# Flask Environment (development / production)
FLASK_ENV=production
FLASK_DEBUG=0

# Secret Key (Ganti dengan string acak panjang di production)
# Anda bisa generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-kunci-rahasia-yang-panjang-dan-aman-disini

# Konfigurasi Upload (dalam Megabytes)
MAX_UPLOAD_MB=16

# Server Port (Opsional, untuk Gunicorn/VPS)
PORT=5000
HOST=0.0.0.0
